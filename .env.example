# Copy to .env.local and fill in. Never commit real values.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# Protects the cron endpoints (Vercel Cron sends it as a bearer token)
CRON_SECRET=generate-a-random-string

# ── Email (outbound + inbound replies) ──────────────────────────────────────
# Which provider sendEmail() uses: "smtp" or "resend" (default resend)
EMAIL_PROVIDER=smtp

# SMTP. SMTP_FROM is the From address; if unset, SMTP_USER is used.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=mailbox@yourdomain.com
SMTP_PASS=your-mailbox-password
SMTP_FROM=mailbox@yourdomain.com

# Inbound replies are read from this mailbox over IMAP (read-only).
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_USER=mailbox@yourdomain.com
IMAP_PASS=your-mailbox-password

# Reply-To on outbound mail. If unset, IMAP_USER is used, so replies land in
# the mailbox the sync reads.
# EMAIL_REPLY_TO=mailbox@yourdomain.com

# Resend (only when EMAIL_PROVIDER=resend). The From address must be on a
# domain verified in Resend. There is no built-in default.
RESEND_API_KEY=your-resend-key
EMAIL_FROM=outreach@yourdomain.com

# ── FMCSA ───────────────────────────────────────────────────────────────────
FMCSA_API_KEY=your-fmcsa-webkey
FMCSA_USE_MOCK=false
# FMCSA_API_BASE_URL=
# FMCSA_DELIMITER=
# FMCSA_ENTITY_TYPE_COL=
# FMCSA_ENTITY_TYPE_VAL=
# FMCSA_DATE_COL=
# FMCSA_DATE_FORMAT=

# ── Telnyx (calling + SMS) ──────────────────────────────────────────────────
TELNYX_API_KEY=your-telnyx-key
TELNYX_SIP_CONNECTION_ID=your-credential-connection-id
NEXT_PUBLIC_TELNYX_FROM_NUMBER=+10000000000
TELNYX_SMS_NUMBER=+10000000000
TELNYX_MESSAGING_PROFILE_ID=your-messaging-profile-id

# ── Sales Copilot ───────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=your-deepgram-key
# gemini (default) or anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=   (optional override; otherwise the newest stable Flash model is used)
# ANTHROPIC_API_KEY=your-anthropic-key

# ── AI calling ──────────────────────────────────────────────────────────────
# Which voice provider places AI calls: "retell" or "vapi"
VOICE_PROVIDER=retell
# AI_CALL_TRANSFER_NUMBER=+10000000000

# Retell (VOICE_PROVIDER=retell)
RETELL_API_KEY=your-retell-key
RETELL_AGENT_ID=agent_xxxxxxxx
RETELL_FROM_NUMBER=+10000000000

# Vapi (VOICE_PROVIDER=vapi)
# Private API key (server only, never expose to the browser)
VAPI_API_KEY=your-vapi-private-key
# Created by: npx tsx --env-file=.env.local scripts/create-vapi-assistant.ts
VAPI_ASSISTANT_ID=your-assistant-id
# The id of your phone number inside Vapi (Dashboard -> Phone Numbers)
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
# Shared secret Vapi sends to /api/webhooks/voice/vapi (the assistant is created with it).
# Generate: openssl rand -base64 32
VAPI_WEBHOOK_SECRET=generate-a-random-string
# Optional: VAPI_VOICE_ID=Tara   VAPI_LLM_MODEL=gpt-5.4-mini
